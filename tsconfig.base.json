{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@sketchy-js/*": ["packages/*/src/index.ts"],
      "@sketchy-js/core/options": ["packages/core/src/options/index.ts"],
      "@sketchy-js/fills/*": ["packages/fills/src/*.ts"],
      "@sketchy-js/scene/basic": ["packages/scene/src/basic.ts"],
      "@sketchy-js/plugin/schema": ["packages/plugin/src/schema/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "types": []
  }
}
