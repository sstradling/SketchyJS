{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@sketchy-js/sketchy": ["packages/sketchy/src/index.ts"],
      "@sketchy-js/sketchy/types": ["packages/sketchy/src/types/index.ts"],
      "@sketchy-js/sketchy/plugin": ["packages/sketchy/src/plugin/index.ts"],
      "@sketchy-js/sketchy/plugin/schema": ["packages/sketchy/src/plugin/schema/index.ts"],
      "@sketchy-js/sketchy/core": ["packages/sketchy/src/core/index.ts"],
      "@sketchy-js/sketchy/core/options": ["packages/sketchy/src/core/options/index.ts"],
      "@sketchy-js/sketchy/fills": ["packages/sketchy/src/fills/index.ts"],
      "@sketchy-js/sketchy/fills/*": ["packages/sketchy/src/fills/*.ts"],
      "@sketchy-js/sketchy/brushes": ["packages/sketchy/src/brushes/index.ts"],
      "@sketchy-js/sketchy/brushes/crayon": ["packages/sketchy/src/brushes/crayon.ts"],
      "@sketchy-js/sketchy/brushes/watercolor": ["packages/sketchy/src/brushes/watercolor.ts"],
      "@sketchy-js/sketchy/stickers": ["packages/sketchy/src/stickers/index.ts"],
      "@sketchy-js/sketchy/stickers/image": ["packages/sketchy/src/stickers/image/index.ts"],
      "@sketchy-js/sketchy/stickers/clipper": ["packages/sketchy/src/stickers/clipper/adapter.ts"],
      "@sketchy-js/sketchy/scene": ["packages/sketchy/src/scene/index.ts"],
      "@sketchy-js/sketchy/scene/basic": ["packages/sketchy/src/scene/basic.ts"],
      "@sketchy-js/sketchy/scene/stickers": ["packages/sketchy/src/scene/stickers.ts"],
      "@sketchy-js/sketchy/scene/silhouette": ["packages/sketchy/src/scene/silhouette.ts"],
      "@sketchy-js/sketchy/svg": ["packages/sketchy/src/svg/index.ts"],
      "@sketchy-js/sketchy/canvas": ["packages/sketchy/src/canvas/index.ts"],
      "@sketchy-js/sketchy/animate": ["packages/sketchy/src/animate/index.ts"],
      "@sketchy-js/sketchy/web-components": ["packages/sketchy/src/web-components/index.ts"],
      "@sketchy-js/react": ["packages/react/src/index.ts"],
      "@sketchy-js/react/canvas": ["packages/react/src/canvas.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "types": []
  }
}
