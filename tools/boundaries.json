{
  "$comment": "Folder rules inside @sketchy-js/sketchy, plus the two publishable packages. Every area gets the DOM-global ban unless it is listed in domAreas.",
  "packages": {
    "sketchy": { "dependencies": [] },
    "react": { "dependencies": ["sketchy"], "externalPeers": ["react"] }
  },
  "areas": {
    "types": [],
    "plugin": ["types"],
    "core": ["types", "plugin"],
    "fills": ["plugin"],
    "brushes": ["plugin", "core"],
    "stickers": ["plugin", "core", "types"],
    "scene": ["types", "plugin", "core", "fills", "stickers"],
    "svg": ["types"],
    "canvas": ["types"],
    "animate": ["types", "core"],
    "web-components": ["types", "scene", "svg", "core"],
    "root": ["core", "scene"]
  },
  "domAreas": ["svg", "canvas", "web-components"],
  "bannedInPureGeometry": {
    "globals": [
      "window",
      "document",
      "navigator",
      "Path2D",
      "OffscreenCanvas",
      "performance",
      "crypto",
      "localStorage"
    ],
    "members": ["Math.random", "Date.now", "performance.now", "crypto.getRandomValues"],
    "newExpressions": ["Date"]
  }
}
