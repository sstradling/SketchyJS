{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sketchyjs:schema:path-operations:v1",
  "title": "Sketchy path operations",
  "$ref": "#/definitions/Path",
  "definitions": {
    "Path": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PathOp"
      },
      "description": "An ordered list of operations forming one or more subpaths."
    },
    "PathOp": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "M"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "op",
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "L"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "op",
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "Q"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "op",
            "cx",
            "cy",
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "C"
            },
            "c1x": {
              "type": "number"
            },
            "c1y": {
              "type": "number"
            },
            "c2x": {
              "type": "number"
            },
            "c2y": {
              "type": "number"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "op",
            "c1x",
            "c1y",
            "c2x",
            "c2y",
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "Z"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        }
      ],
      "description": "One drawing operation. Coordinates are absolute."
    },
    "Seed": {
      "description": "Deterministic seed: a non-negative safe integer, or a decimal string for values up to 2^64 - 1.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        }
      ]
    },
    "SerializedSeed": {
      "description": "Deterministic seed: a non-negative safe integer, or a decimal string for values up to 2^64 - 1.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        }
      ]
    },
    "Color": {
      "description": "A CSS color string, or an sRGB tuple [r, g, b] or [r, g, b, a] with components in 0..1.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      ]
    }
  }
}
