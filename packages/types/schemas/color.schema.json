{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sketchyjs:schema:color:v1",
  "title": "Sketchy color",
  "$ref": "#/definitions/Color",
  "definitions": {
    "Color": {
      "description": "A CSS color string, or an sRGB tuple [r, g, b] or [r, g, b, a] with components in 0..1.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      ]
    },
    "Seed": {
      "description": "Deterministic seed: a non-negative safe integer, or a decimal string for values up to 2^64 - 1.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        }
      ]
    },
    "SerializedSeed": {
      "description": "Deterministic seed: a non-negative safe integer, or a decimal string for values up to 2^64 - 1.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        }
      ]
    }
  }
}
