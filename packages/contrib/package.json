{
  "name": "@sketchy-js/contrib",
  "version": "1.6.0",
  "description": "SketchyJS contrib package.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@sketchy-js/plugin": "workspace:^"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sstradling/SketchyJS.git",
    "directory": "packages/contrib"
  },
  "homepage": "https://github.com/sstradling/SketchyJS#readme",
  "bugs": {
    "url": "https://github.com/sstradling/SketchyJS/issues"
  }
}
