{
  "name": "@sketchy-js/react",
  "version": "0.0.0",
  "description": "React bindings for SketchyJS. SVG by default; Canvas is a subpath.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sketchy-js/sketchy": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.1",
    "react": "18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sstradling/SketchyJS.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/sstradling/SketchyJS#readme",
  "bugs": {
    "url": "https://github.com/sstradling/SketchyJS/issues"
  }
}
