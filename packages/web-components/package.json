{
  "name": "@sketchy/web-components",
  "version": "0.0.0",
  "description": "SketchyJS web-components package.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sketchy/types": "workspace:*",
    "@sketchy/scene": "workspace:*"
  }
}
