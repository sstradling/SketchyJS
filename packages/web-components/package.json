{
  "name": "@sketchy-js/web-components",
  "version": "0.0.0",
  "description": "SketchyJS web-components package.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sketchy-js/types": "workspace:*",
    "@sketchy-js/scene": "workspace:*",
    "@sketchy-js/svg-renderer": "workspace:*",
    "@sketchy-js/core": "workspace:*"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sstradling/SketchyJS.git",
    "directory": "packages/web-components"
  },
  "homepage": "https://github.com/sstradling/SketchyJS#readme",
  "bugs": {
    "url": "https://github.com/sstradling/SketchyJS/issues"
  }
}
