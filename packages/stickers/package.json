{
  "name": "@sketchy-js/stickers",
  "version": "0.0.0",
  "description": "SketchyJS stickers package.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./clipper": {
      "types": "./dist/clipper.d.ts",
      "import": "./dist/clipper.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sketchy-js/core": "workspace:*",
    "@sketchy-js/plugin": "workspace:*",
    "@sketchy-js/types": "workspace:*",
    "clipper2-ts": "2.0.1-19"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
