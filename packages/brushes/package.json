{
  "name": "@sketchy-js/brushes",
  "version": "0.0.0",
  "description": "SketchyJS brushes package.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crayon": {
      "types": "./dist/crayon.d.ts",
      "import": "./dist/crayon.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sketchy-js/plugin": "workspace:*",
    "@sketchy-js/core": "workspace:*"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
